        "rule_id": "risk_high",
        "priority": 2,
        "action": "DECLINE",
        "reason_code": "RISK_HIGH",
        "when": [
          {
            "field": "risk.pd",
            "op": "gt",
            "value": 0.1
          }
        ]
      },
      {
        "rule_id": "risk_low",
        "priority": 3,
        "action": "APPROVE",
        "reason_code": "RISK_LOW",
        "when": [
          {
            "field": "risk.pd",
            "op": "le",
            "value": 0.05
          }
