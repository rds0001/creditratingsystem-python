      "performance_origin": "first_draw_at"
    },
    "default_action": "REFER",
    "missing_action": "BLOCKED",
    "fields": {
      "risk.pd": {
        "type": "number"
      },
      "affordability.status": {
        "type": "category",
        "values": [
          "AFFORDABLE",
          "NOT_AFFORDABLE",
          "INSUFFICIENT_EVIDENCE"
        ]
      },
      "eligibility.status": {
        "type": "category",
        "values": [
          "ELIGIBLE",
          "INELIGIBLE"
        ]
      }
    },
    "rules": [
      {
        "rule_id": "eligibility",
        "priority": 0,
        "action": "DECLINE",
        "reason_code": "ELIGIBILITY",
        "when": [
          {
            "field": "eligibility.status",
            "op": "eq",
            "value": "INELIGIBLE"
          }
        ]
      },
      {
        "rule_id": "affordability",
        "priority": 1,
        "action": "DECLINE",
        "reason_code": "AFFORDABILITY",
        "when": [
          {
            "field": "affordability.status",
            "op": "eq",
            "value": "NOT_AFFORDABLE"
          }
        ]
      },
      {
        "rule_id": "risk_high",
        "priority": 2,
        "action": "DECLINE",
        "reason_code": "RISK_HIGH",
        "when": [
          {
            "field": "risk.pd",
            "op": "gt",
            "value": 0.1
          }
        ]
      },
      {
        "rule_id": "risk_low",
        "priority": 3,
        "action": "APPROVE",
        "reason_code": "RISK_LOW",
        "when": [
          {
            "field": "risk.pd",
            "op": "le",
            "value": 0.05
          }
        ]
      }
    ]
  },
